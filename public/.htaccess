# SPA routing for the Matthew Willman React site on Apache (xneelo).
# Serves real files/folders as-is, and routes every other request to
# index.html so React Router can handle client-side routes (/artist, etc.).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical domain: permanently redirect any matthewwillman.co.za host
  # (apex, www, or legacy subdomains) to the equivalent .com URL. Host-scoped,
  # so requests already on .com are never matched (no redirect loop).
  RewriteCond %{HTTP_HOST} matthewwillman\.co\.za$ [NC]
  RewriteRule ^ https://www.matthewwillman.com%{REQUEST_URI} [L,R=301]

  # Canonical host: send the bare apex matthewwillman.com to the www. version.
  # Anchored to the exact apex, so www.matthewwillman.com never matches (no loop).
  RewriteCond %{HTTP_HOST} ^matthewwillman\.com$ [NC]
  RewriteRule ^ https://www.matthewwillman.com%{REQUEST_URI} [L,R=301]

  # If the requested file or directory exists, serve it directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, hand off to the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache fingerprinted build assets; keep HTML fresh.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|jpg|jpeg|png|webp|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Gzip text assets if available.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
